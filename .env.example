# --- Database (Neon / Supabase / local Postgres 16+) ---
# Use the *pooled* connection string on Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/northside

# --- Public URL used in emails, .ics files and auth callbacks ---
APP_URL=http://localhost:3000

# --- Auth (Better Auth) — generate with: openssl rand -base64 32 ---
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# --- Signed cancel/reschedule links — openssl rand -base64 32 ---
BOOKING_TOKEN_SECRET=replace-me-with-32-random-bytes

# --- Email (Resend). Leave RESEND_API_KEY empty to log emails to the console instead. ---
RESEND_API_KEY=
EMAIL_FROM="Northside Physio <bookings@example.com>"

# --- Reminder cron: Vercel Cron and the GitHub Action send "Authorization: Bearer $CRON_SECRET" ---
CRON_SECRET=replace-me-with-a-long-random-string

# --- Optional: stable key for Server Action closure encryption across instances ---
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
